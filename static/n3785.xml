      1 
      <b><span class="alpheios-lex-ar" lang="ara">تَجَهَ</span></b> , aor. 
    
      <b><span class="alpheios-lex-ar" lang="ara">1َ2َ3َ</span></b> , (AZ, K, art. <span class="alpheios-lex-ar" lang="ara">وجه</span>,) inf. n. <span class="alpheios-lex-ar" lang="ara">تَجْهٌ</span>;
