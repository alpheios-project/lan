      <b><span class="alpheios-lex-ar" lang="ara">تسافدت السِبَاعُ</span></b>  (S) and <span class="alpheios-lex-ar" lang="ara">الطُّيُورُ</span>, (A,) or <span class="alpheios-lex-ar" lang="ara">تسافد</span>
<span class="alpheios-lex-ar" lang="ara">السِبَاعُ</span> (K) and <span class="alpheios-lex-ar" lang="ara">الطُّيُورُ</span>, (TA,) and <span class="alpheios-lex-ar" lang="ara">الشِيَاهُ</span> ↓ <b><span class="alpheios-lex-ar" lang="ara">سافدت</span></b> ,
