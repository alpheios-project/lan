      <b><span class="alpheios-lex-ar" lang="ara">لَصْتٌ</span></b>  (S, K) and <span class="alpheios-lex-ar" lang="ara">لِصْتٌ</span> and <span class="alpheios-lex-ar" lang="ara">لُصْتٌ</span> (K) <i>i. q.</i> <span class="alpheios-lex-ar" lang="ara">لِصٌّ</span>,
