      <b><span class="alpheios-lex-ar" lang="ara">سَجِينٌ</span></b>  is <i>syn. with</i> ↓ <b><span class="alpheios-lex-ar" lang="ara">مَسْجُونٌ</span></b>  [<i>Imprisoned</i>];
