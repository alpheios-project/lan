      <b><span class="alpheios-lex-ar" lang="ara">رَجُلٌ مُدْمِنُ خَمْرٍ</span></b> , (S,) or <span class="alpheios-lex-ar" lang="ara">مُدْمِنُ الخَمْرِ</span>, (T,)
