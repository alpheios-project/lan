    <div class="alpheios-lex-entry" lemma-id="n37177" root="كلثب" body-key="k">
    
      <b><span class="alpheios-lex-ar" lang="ara">كَلْثَبٌ</span></b>  and <span class="alpheios-lex-ar" lang="ara">كُلَاثِبٌ</span> <i>Contracted</i> [<i>in hand</i> or
