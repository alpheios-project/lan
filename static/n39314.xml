    <div class="alpheios-lex-entry" lemma-id="n39314" root="نثت" body-key="n">
    
      <b><span class="alpheios-lex-ar" lang="ara">نَثِتَ</span></b> , aor. 
    
      <b><span class="alpheios-lex-ar" lang="ara">نَثَتَ</span></b> , [inf. n. <span class="alpheios-lex-ar" lang="ara">نَثَتٌ</span>,] <i>It</i> (flesh-meat)
